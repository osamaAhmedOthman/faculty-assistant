
# Required credentials
GROQ_API_KEY=your-groq-api-key
PINECONE_API_KEY=your-pinecone-api-key

# LLM and vector database
GROQ_MODEL=openai/gpt-oss-120b
PINECONE_INDEX_NAME=faculty-assistant
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine

# Local embedding model and ingestion settings
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Retrieval
RETRIEVAL_TOP_K=5

# API, dashboard, and logging
API_ALLOWED_ORIGINS=http://localhost:8501
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Evaluation only
RAGAS_JUDGE_MODEL=openai/gpt-oss-20b
